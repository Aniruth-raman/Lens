{
  "expo": {
    "name": "Lens",
    "slug": "Lens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Lens needs camera access to scan documents.",
        "NSPhotoLibraryUsageDescription": "Lens needs photo library access to save scanned documents.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aniruth.lens"
    },
    "plugins": [
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Lens needs camera access to scan documents."
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Inter.ttf"]
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "5bf9fe07-f9bb-4c47-98c0-7e3b59dbd652"
      }
    }
  }
}
